# Copie para .env.local (next dev). Nunca commite valores reais.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
FIREBASE_PROJECT_ID=your-project-id
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<seu-cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=despesas

# Anexos e comprovantes: Cloudflare R2 pela API S3. Sem estas quatro variáveis, o desenvolvimento
# (npm run dev) guarda os arquivos em disco, em .data/attachments/. Em produção elas são obrigatórias.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-bucket-name

# Avisos. Sem estas variáveis o canal correspondente fica desligado (não dá erro).
# Endereço público do app, usado nos links dos e-mails (padrão: https://paguesuaparte.com.br em produção).
APP_URL=https://paguesuaparte.com.br
# E-mail (Mailgun): chave de envio, domínio de envio, região (us ou eu; opcional) e remetente.
MAILGUN_SENDING_KEY=your-mailgun-sending-key
MAILGUN_DOMAIN=mg.example.com
MAILGUN_REGION=us
EMAIL_FROM=PagueSuaParte <avisos@paguesuaparte.com.br>
# Push (Web Push/VAPID): gere o par com `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
